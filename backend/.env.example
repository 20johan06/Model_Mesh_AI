PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Active LLM Provider Selection ('gemini' | 'huggingface')
LLM_PROVIDER=gemini

# Google Gemini Developer API Key (Required for Gemini Execution)
# Get a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model ID (e.g., 'gemini-3.8-flash', 'gemini-2.0-flash', 'gemini-1.5-pro')
GEMINI_MODEL=gemini-3.8-flash

# Hugging Face Inference API Token (Alternative Provider)
# Get a user access token from: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_api_token_here
